generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Listing {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  description     String?
  price           Int
  priceType       String   @default("sale") @map("price_type")
  propertyType    String   @default("apartment") @map("property_type")
  location        String?
  area            Int?
  bedrooms        Int?
  bathrooms       Int?
  featured        Boolean  @default(false)
  imageUrl        String?  @map("image_url")
  status          String   @default("active")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("listings")
}

model Blog {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  excerpt         String?
  content         String?
  category        String   @default("General")
  featuredImage   String?  @map("featured_image")
  status          String   @default("draft")
  author          String   @default("Prolific Properties")
  readTime        String   @default("5 min read") @map("read_time")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("blogs")
}

model Contact {
  id          Int      @id @default(autoincrement())
  fullName    String   @map("full_name")
  phone       String
  email       String
  interest    String
  budget      String?
  message     String
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("contacts")
}
